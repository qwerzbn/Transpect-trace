{
  "manifest_version": 3,
  "name": "Transpect controlled browser observation",
  "version": "0.1.0",
  "description": "Observe explicitly enrolled localhost text requests. No blocking or general browsing capture.",
  "key": "",
  "permissions": ["webRequest", "nativeMessaging", "storage"],
  "host_permissions": ["https://localhost/*", "https://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Controlled observation status", "default_popup": "popup.html"}
}
