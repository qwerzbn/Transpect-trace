{
  "$defs": {
    "DetectionFinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "transpect.protect.finding/1.0",
          "default": "transpect.protect.finding/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "strength": {
          "enum": [
            "weak",
            "contextual",
            "exact"
          ],
          "title": "Strength",
          "type": "string"
        },
        "sensitivity": {
          "default": "UNKNOWN",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "SECRET",
            "UNKNOWN"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "data_types": {
          "items": {
            "enum": [
              "credential",
              "private_key",
              "source_code",
              "personal_information",
              "registered_text"
            ],
            "type": "string"
          },
          "title": "Data Types",
          "type": "array"
        },
        "evidence_sha256": {
          "title": "Evidence Sha256",
          "type": "string"
        },
        "registration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registration Id"
        },
        "index_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Version"
        }
      },
      "required": [
        "detector_version",
        "rule_id",
        "location",
        "severity",
        "strength",
        "data_types",
        "evidence_sha256"
      ],
      "title": "DetectionFinding",
      "type": "object"
    },
    "FlowProcess": {
      "additionalProperties": false,
      "properties": {
        "can_enforce": {
          "const": false,
          "default": false,
          "title": "Can Enforce",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Role",
          "type": "string"
        },
        "pid": {
          "exclusiveMinimum": 0,
          "title": "Pid",
          "type": "integer"
        },
        "creation_filetime": {
          "exclusiveMinimum": 0,
          "title": "Creation Filetime",
          "type": "integer"
        },
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "pid",
        "creation_filetime",
        "image_sha256"
      ],
      "title": "FlowProcess",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "can_enforce": {
      "const": false,
      "default": false,
      "title": "Can Enforce",
      "type": "boolean"
    },
    "schema_version": {
      "const": "transpect.flow.outbound/1.0",
      "default": "transpect.flow.outbound/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "original_observation_id": {
      "title": "Original Observation Id",
      "type": "string"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "process": {
      "$ref": "#/$defs/FlowProcess"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "capture_layer": {
      "title": "Capture Layer",
      "type": "string"
    },
    "connection_id_sha256": {
      "title": "Connection Id Sha256",
      "type": "string"
    },
    "stream_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stream Id"
    },
    "protocol": {
      "title": "Protocol",
      "type": "string"
    },
    "destination_host": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination Host"
    },
    "captured_qpc": {
      "minimum": 0,
      "title": "Captured Qpc",
      "type": "integer"
    },
    "qpc_frequency": {
      "exclusiveMinimum": 0,
      "title": "Qpc Frequency",
      "type": "integer"
    },
    "body_bytes": {
      "minimum": 0,
      "title": "Body Bytes",
      "type": "integer"
    },
    "raw_body_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Body Sha256",
      "type": "string"
    },
    "decoded_body_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decoded Body Sha256"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "content_type": {
      "enum": [
        "text/plain",
        "application/json",
        "unsupported"
      ],
      "title": "Content Type",
      "type": "string"
    },
    "encoding_state": {
      "enum": [
        "identity",
        "unsupported",
        "unknown"
      ],
      "title": "Encoding State",
      "type": "string"
    },
    "parsing_state": {
      "enum": [
        "text",
        "json",
        "failed",
        "unsupported"
      ],
      "title": "Parsing State",
      "type": "string"
    },
    "llm_classification": {
      "enum": [
        "LLM",
        "NON_LLM",
        "UNKNOWN"
      ],
      "title": "Llm Classification",
      "type": "string"
    },
    "detection_status": {
      "enum": [
        "matched",
        "no_match",
        "incomplete"
      ],
      "title": "Detection Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DetectionFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "send_evidence": {
      "default": "unverified",
      "enum": [
        "encryption_input_observed",
        "request_constructed",
        "unverified"
      ],
      "title": "Send Evidence",
      "type": "string"
    }
  },
  "required": [
    "original_observation_id",
    "session_id",
    "process",
    "provider",
    "capture_layer",
    "connection_id_sha256",
    "protocol",
    "captured_qpc",
    "qpc_frequency",
    "body_bytes",
    "raw_body_sha256",
    "completeness",
    "content_type",
    "encoding_state",
    "parsing_state",
    "llm_classification",
    "detection_status"
  ],
  "title": "OutboundContentObservation",
  "type": "object"
}
