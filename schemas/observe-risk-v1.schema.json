{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "transpect.observe.risk/1.0",
      "default": "transpect.observe.risk/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "risk": {
      "enum": [
        "critical",
        "warning",
        "no_match",
        "unknown"
      ],
      "title": "Risk",
      "type": "string"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "integer"
    },
    "matched_rule_ids": {
      "items": {
        "type": "string"
      },
      "title": "Matched Rule Ids",
      "type": "array"
    },
    "candidate_source_paths": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Source Paths",
      "type": "array"
    },
    "source_confidence": {
      "default": "Unknown",
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unknown"
      ],
      "title": "Source Confidence",
      "type": "string"
    },
    "recommended_action": {
      "enum": [
        "block_request",
        "warn",
        "audit"
      ],
      "title": "Recommended Action",
      "type": "string"
    },
    "effective_action": {
      "const": "audit",
      "default": "audit",
      "title": "Effective Action",
      "type": "string"
    },
    "can_enforce": {
      "const": false,
      "default": false,
      "title": "Can Enforce",
      "type": "boolean"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "observation_id",
    "risk",
    "score",
    "matched_rule_ids",
    "candidate_source_paths",
    "recommended_action",
    "policy_version",
    "limitations"
  ],
  "title": "RiskAssessment",
  "type": "object"
}
