{
  "$defs": {
    "DetectionFinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "transpect.protect.finding/1.0",
          "default": "transpect.protect.finding/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "strength": {
          "enum": [
            "weak",
            "contextual",
            "exact"
          ],
          "title": "Strength",
          "type": "string"
        },
        "sensitivity": {
          "default": "UNKNOWN",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "SECRET",
            "UNKNOWN"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "data_types": {
          "items": {
            "enum": [
              "credential",
              "private_key",
              "source_code",
              "personal_information",
              "registered_text"
            ],
            "type": "string"
          },
          "title": "Data Types",
          "type": "array"
        },
        "evidence_sha256": {
          "title": "Evidence Sha256",
          "type": "string"
        },
        "registration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registration Id"
        },
        "index_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Version"
        }
      },
      "required": [
        "detector_version",
        "rule_id",
        "location",
        "severity",
        "strength",
        "data_types",
        "evidence_sha256"
      ],
      "title": "DetectionFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "transpect.chrome.content.verdict/1.0",
      "default": "transpect.chrome.content.verdict/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "request_token_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Token Sha256",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "BLOCK",
        "UNKNOWN"
      ],
      "title": "Decision",
      "type": "string"
    },
    "action": {
      "enum": [
        "allow",
        "block"
      ],
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "maxLength": 127,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 127,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "detection_status": {
      "enum": [
        "matched",
        "no_match",
        "incomplete"
      ],
      "title": "Detection Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DetectionFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "attempt_id",
    "request_token_sha256",
    "decision",
    "action",
    "reason",
    "policy_version",
    "detection_status"
  ],
  "title": "ContentAnalysisVerdict",
  "type": "object"
}
