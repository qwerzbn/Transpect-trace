{
  "$defs": {
    "DetectionFinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "transpect.protect.finding/1.0",
          "default": "transpect.protect.finding/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "detector_version": {
          "title": "Detector Version",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "strength": {
          "enum": [
            "weak",
            "contextual",
            "exact"
          ],
          "title": "Strength",
          "type": "string"
        },
        "sensitivity": {
          "default": "UNKNOWN",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "SECRET",
            "UNKNOWN"
          ],
          "title": "Sensitivity",
          "type": "string"
        },
        "data_types": {
          "items": {
            "enum": [
              "credential",
              "private_key",
              "source_code",
              "personal_information",
              "registered_text"
            ],
            "type": "string"
          },
          "title": "Data Types",
          "type": "array"
        },
        "evidence_sha256": {
          "title": "Evidence Sha256",
          "type": "string"
        },
        "registration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registration Id"
        },
        "index_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Version"
        }
      },
      "required": [
        "detector_version",
        "rule_id",
        "location",
        "severity",
        "strength",
        "data_types",
        "evidence_sha256"
      ],
      "title": "DetectionFinding",
      "type": "object"
    },
    "FlowProcess": {
      "additionalProperties": false,
      "properties": {
        "can_enforce": {
          "const": false,
          "default": false,
          "title": "Can Enforce",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Role",
          "type": "string"
        },
        "pid": {
          "exclusiveMinimum": 0,
          "title": "Pid",
          "type": "integer"
        },
        "creation_filetime": {
          "exclusiveMinimum": 0,
          "title": "Creation Filetime",
          "type": "integer"
        },
        "image_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "pid",
        "creation_filetime",
        "image_sha256"
      ],
      "title": "FlowProcess",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "can_enforce": {
      "const": false,
      "default": false,
      "title": "Can Enforce",
      "type": "boolean"
    },
    "schema_version": {
      "const": "transpect.flow.transfer/1.0",
      "default": "transpect.flow.transfer/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "observation_id": {
      "title": "Observation Id",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "process": {
      "$ref": "#/$defs/FlowProcess"
    },
    "object_kind": {
      "enum": [
        "file",
        "pipe"
      ],
      "title": "Object Kind",
      "type": "string"
    },
    "operation": {
      "enum": [
        "read",
        "write"
      ],
      "title": "Operation",
      "type": "string"
    },
    "resource_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Id"
    },
    "resource_role": {
      "default": "unknown",
      "enum": [
        "source",
        "transfer",
        "pipe",
        "unknown"
      ],
      "title": "Resource Role",
      "type": "string"
    },
    "open_generation": {
      "minimum": 0,
      "title": "Open Generation",
      "type": "integer"
    },
    "connection_generation": {
      "default": 0,
      "minimum": 0,
      "title": "Connection Generation",
      "type": "integer"
    },
    "file_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Version"
    },
    "peer_pid": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peer Pid"
    },
    "peer_creation_filetime": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peer Creation Filetime"
    },
    "first_qpc": {
      "minimum": 0,
      "title": "First Qpc",
      "type": "integer"
    },
    "last_qpc": {
      "minimum": 0,
      "title": "Last Qpc",
      "type": "integer"
    },
    "qpc_frequency": {
      "exclusiveMinimum": 0,
      "title": "Qpc Frequency",
      "type": "integer"
    },
    "first_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Offset"
    },
    "completed_bytes": {
      "minimum": 0,
      "title": "Completed Bytes",
      "type": "integer"
    },
    "captured_bytes": {
      "maximum": 1048576,
      "minimum": 0,
      "title": "Captured Bytes",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "evidence_event_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Event Ids",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/DetectionFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "process",
    "object_kind",
    "operation",
    "open_generation",
    "first_qpc",
    "last_qpc",
    "qpc_frequency",
    "completed_bytes",
    "captured_bytes",
    "content_sha256",
    "completeness",
    "evidence_event_ids"
  ],
  "title": "TransferObservation",
  "type": "object"
}
