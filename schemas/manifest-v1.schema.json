{
  "$defs": {
    "CollectorState": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "default": "unknown",
          "title": "Version",
          "type": "string"
        },
        "started": {
          "default": false,
          "title": "Started",
          "type": "boolean"
        },
        "stopped": {
          "default": false,
          "title": "Stopped",
          "type": "boolean"
        },
        "dropped_events": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped Events",
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "CollectorState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "transpect.trace.manifest/1.0",
      "default": "transpect.trace.manifest/1.0",
      "title": "Schema",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "default": "running",
      "enum": [
        "running",
        "complete",
        "incomplete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "client": {
      "title": "Client",
      "type": "string"
    },
    "client_version": {
      "default": "unknown",
      "title": "Client Version",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "workspace": {
      "title": "Workspace",
      "type": "string"
    },
    "host": {
      "additionalProperties": true,
      "title": "Host",
      "type": "object"
    },
    "container": {
      "additionalProperties": true,
      "title": "Container",
      "type": "object"
    },
    "collectors": {
      "items": {
        "$ref": "#/$defs/CollectorState"
      },
      "title": "Collectors",
      "type": "array"
    },
    "configuration": {
      "additionalProperties": true,
      "title": "Configuration",
      "type": "object"
    },
    "failure": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    }
  },
  "required": [
    "client",
    "provider",
    "model",
    "workspace"
  ],
  "title": "Manifest",
  "type": "object"
}
