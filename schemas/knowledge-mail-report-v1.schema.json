      "default": null,
      "title": "Services"
    },
    "service_cleanup_errors": {
      "items": {
        "type": "string"
      },
      "title": "Service Cleanup Errors",
      "type": "array"
    },
    "service_cleanup_confirmed": {
      "default": false,
      "title": "Service Cleanup Confirmed",
      "type": "boolean"
    }
