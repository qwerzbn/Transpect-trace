{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "transpect.knowledge-mail.report/1.0",
      "default": "transpect.knowledge-mail.report/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "starting_services",
        "running_codex",
        "complete",
        "partial",
        "unavailable"
