{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transpect.local/schemas/gateway-policy-v1.schema.json",
  "title": "Transpect Gateway Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "version",
    "allowed_upstreams",
    "allowed_source_paths",
    "content_markers"
  ],
  "properties": {
    "schema": {
      "const": "transpect.gateway.policy/1.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "allowed_upstreams": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "allowed_source_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "content_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["marker_id", "value", "source_path"],
        "properties": {
          "marker_id": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
